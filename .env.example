# Database
DATABASE_URL=postgresql+asyncpg://pdh:changeme@localhost:5432/personal_data_hub
POSTGRES_DB=personal_data_hub
POSTGRES_USER=pdh
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://localhost:6379

# Embedding
EMBEDDING_MODEL=all-mpnet-base-v2

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Local data mount (path to your files for ingestion)
DATA_MOUNT_PATH=./data

# GitHub (optional, for higher rate limits)
GITHUB_TOKEN=

# Frontend
VITE_API_URL=http://localhost:8000
